DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus"

# Base URL of the app. Used to build email verification links
# and the Google OAuth redirect URI.
APP_URL="http://localhost:3000"

# Email delivery via Gmail SMTP (Nodemailer).
# SMTP_PASS is a Gmail App Password (https://myaccount.google.com/apppasswords),
# NOT your normal Gmail password.
# Without SMTP credentials, non-production environments print
# email content to the server console instead of sending.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS="REPLACE_WITH_YOUR_GMAIL_APP_PASSWORD"
EMAIL_FROM="Nexus <your-email@example.com>"

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
# Register this exact Authorized Redirect URI in the OAuth client:
#   {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# File upload storage
# "local" (default) stores bytes under STORAGE_DIR (defaults to <project>/uploads)
# and is intended for local development.
# "vercel-blob" stores bytes in a Vercel Blob store for production (Vercel)
# deployments. Bytes are kept in durable object storage instead of the
# serverless filesystem (/var/task/uploads), which is ephemeral and read-only.
STORAGE_DRIVER="local"
STORAGE_DIR="uploads"

# --- Vercel Blob (production) ------------------------------------------------
# 1. Create a Blob store in the Vercel dashboard and connect it to the project.
# 2. Set STORAGE_DRIVER="vercel-blob" in the production environment.
# 3. Vercel injects the store credentials automatically:
#    - BLOB_READ_WRITE_TOKEN (classic token), or
#    - BLOB_STORE_ID + VERCEL_OIDC_TOKEN (recommended OIDC auth).
#    After connecting the store, `vercel env pull` writes these to .env*.
#
# Avatar uploads (<= 2 MB) go through the Server Action path. Task attachment
# uploads (up to 10 MB) exceed Vercel's ~4.5 MB serverless request-body limit,
# so browsers upload them directly to the Blob store via a short-lived signed
# URL issued by the server (see getStorageUploadPath in src/lib/files/storage.ts).

# Rate limiting backend.
# "memory" (default) limits within a single process and is NOT shared across
# instances. Production deployments with more than one instance must provide
# a distributed store (Redis) behind the RateLimitStore interface.
RATE_LIMIT_STORE="memory"
